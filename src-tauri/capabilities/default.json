{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PillLauncher capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-message",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "store:default"
  ]
}
